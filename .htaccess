# xuMax website (Apache / cPanel)
DirectoryIndex index.html
Options -Indexes
AddDefaultCharset utf-8

# keep the repo's working folders and dotfiles away from visitors
RedirectMatch 404 ^/\.(git|build|claude)(/|$)
<FilesMatch "^\.(cpanel\.yml|gitignore|DS_Store)$">
  Require all denied
</FilesMatch>

# cache static files for a week; pages stay fresh
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType text/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# compress text files
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript image/svg+xml application/json
</IfModule>
